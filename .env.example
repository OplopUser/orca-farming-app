# Copy to .env and edit. Every value below except the first three equals the code default in
# src/config.ts (tests/env-example.test.ts keeps the two in sync), so delete any line you don't change.

# --- Required -------------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BOT_WALLET_KEYPAIR_PATH=./wallet.json
# Pool for the CLI / legacy bot. Must be non-empty even if you only use the control panel.
ORCA_WHIRLPOOL_ADDRESS=REPLACE_WITH_SOL_USDC_WHIRLPOOL

# --- Control panel (read by src/controlPanel.ts) --------------------------------------------
# Bind address. Keep 127.0.0.1 unless the panel must be reachable from other machines,
# and set UI_TOKEN whenever it is (docker-compose.yml sets UI_HOST=0.0.0.0 inside the container).
UI_HOST=127.0.0.1
UI_PORT=8787
# Shared secret for the panel. When set, the page and every /api call require it
# (login form cookie, or "Authorization: Bearer <token>"). Generate one with: openssl rand -hex 32
UI_TOKEN=

# --- RPC, files, logging --------------------------------------------------------------------
SOLANA_RPC_FALLBACK_URLS=
BOT_STATE_FILE=./data/state.json
BOT_REGISTRY_FILE=./data/bots.json
BOT_PNL_LEDGER_FILE=./data/pnl-ledger.json
LOG_FILE=./data/logs/rebalancer.log
LOG_LEVEL=info
JUPITER_API_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# --- Strategy (CLI / legacy bot; also the control panel's defaults for new bots) ------------
BOT_ALLOCATION_USDC=0
RANGE_PCT=1
REBALANCE_DRIFT_PCT=0.5
POLL_SECONDS=15
DRIFT_CONFIRM_POLLS=2
REBALANCE_MIN_BENEFIT_MULTIPLE=1.5
SOL_RESERVE_LAMPORTS=50000000
MIN_SWAP_USDC=10
OPEN_BALANCE_TOLERANCE_BPS=25

# --- Slippage ladder and deployment buffers (basis points) ----------------------------------
MAX_SLIPPAGE_BPS=25
CLOSE_RETRY_SLIPPAGE_BPS=50
CLOSE_FINAL_RETRY_SLIPPAGE_BPS=100
OPEN_RETRY_SLIPPAGE_BPS=50
OPEN_FINAL_RETRY_SLIPPAGE_BPS=100
SLIPPAGE_RETRIES_PER_TIER=3
OPEN_DEPLOYMENT_BUFFER_BPS=50
OPEN_RETRY_DEPLOYMENT_BUFFER_BPS=150
OPEN_FINAL_DEPLOYMENT_BUFFER_BPS=300

# --- Compounding ----------------------------------------------------------------------------
COMPOUND_INTERVAL_SECONDS=0
COMPOUND_MIN_QUOTE_VALUE=0.5
HARVEST_MIN_BENEFIT_MULTIPLE=2

# --- Token pair (CLI / legacy bot and the panel's wallet summary) ---------------------------
TOKEN_A_MINT=So11111111111111111111111111111111111111112
TOKEN_A_SYMBOL=SOL
TOKEN_A_DECIMALS=9
TOKEN_B_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
TOKEN_B_SYMBOL=USDC
TOKEN_B_DECIMALS=6
